__pycache__/
*.pyc
*.pyo
.DS_Store

# --- runtime artifacts of OUR tools, anchored to the repo root only ---
# (unanchored patterns like `trader/` would silently swallow a same-named
#  directory inside vendored third-party code, which is how files go missing)
/trader/
/trader-console/work/
/trader-console/console-log.jsonl
*.json.gz.tmp

